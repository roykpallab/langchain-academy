# ==========================================
# Google Gemini & GCP Vertex AI Configuration
# ==========================================

# Option A: Google AI Studio (Recommended for local course notebooks)
# Get your API key from: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_API_KEY=your-gemini-api-key-here

# Option B: GCP Vertex AI (Google Cloud Platform)
# Required if using ChatVertexAI
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
# Optional: Path to Service Account JSON key if not using `gcloud auth application-default login`
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ==========================================
# LangSmith Tracing & Observability
# ==========================================
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT="langchain-academy"

# ==========================================
# Web Search Grounding (Used in Module 4)
# ==========================================
# Sign up at https://tavily.com/
TAVILY_API_KEY=your-tavily-api-key-here
